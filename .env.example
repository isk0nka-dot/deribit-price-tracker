POSTGRES_USER=deribit
POSTGRES_PASSWORD=change_me
POSTGRES_DB=deribit
# Used when running the app on the host; Docker Compose overrides host and port
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Used when running the app on the host; Docker Compose overrides it
REDIS_URL=redis://localhost:6379/0
DERIBIT_BASE_URL=https://www.deribit.com/api/v2
